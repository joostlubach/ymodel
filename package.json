{
  "name": "@mosdev/ymodel",
  "version": "1.0.0",
  "description": "Easy to use model base class with basic deserialization support.",
  "author": "Joost Lubach",
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean && npm run build:tsc",
    "build:tsc": "npm run build:tsc:esm && npm run build:tsc:cjs",
    "build:tsc:esm": "tsc -p tsconfig.prod.json --module es2022 --outDir dist/esm --declarationDir dist/types",
    "build:tsc:cjs": "tsc -p tsconfig.prod.json --module commonjs --outDir dist/cjs --declaration false --declarationMap false",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lint": "eslint",
    "check": "tsc -p . --noEmit",
    "test": "vitest"
  },
  "peerDependencies": {
    "typescript": "*"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/lodash": "^4.17.20",
    "@types/luxon": "^3.7.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.4.0",
    "lodash": "^4.17.21",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "yaml": "^2.8.2"
  },
  "dependencies": {
    "luxon": "^3.7.2",
    "@mosdev/ytil": "workspace:^"
  }
}
